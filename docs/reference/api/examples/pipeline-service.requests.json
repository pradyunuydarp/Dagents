{
  "service": "pipeline-service",
  "note": "Captured in process with the planner available, so registering and checking a pipeline ran dagentsc pipeline compile.",
  "examples": [
    {
      "id": "health",
      "endpoint": "GET /api/v1/health",
      "title": "Check that the service answers",
      "request": {
        "path": "/api/v1/health"
      },
      "status": 200
    },
    {
      "id": "register-pipeline",
      "endpoint": "POST /api/v1/pipelines",
      "title": "Register a pipeline of four steps",
      "description": "registered_at is set from the clock, so it differs on every call.",
      "request": {
        "path": "/api/v1/pipelines",
        "json": {
          "pipeline_id": "paid-large-orders",
          "description": "Keep paid orders of 100 or more, add the batch date, and report their total.",
          "steps": [
            {
              "step_id": "keep-paid-large",
              "kind": "filter_items",
              "config": {
                "items_field": "orders",
                "conditions": [
                  {
                    "field": "status",
                    "operator": "eq",
                    "value": "paid"
                  },
                  {
                    "field": "amount",
                    "operator": "gte",
                    "value": 100
                  }
                ]
              }
            },
            {
              "step_id": "tag-batch",
              "kind": "enrich_context",
              "config": {
                "target_field": "context",
                "values": {
                  "batch": "2026-10-13",
                  "currency": "EUR"
                }
              }
            },
            {
              "step_id": "totals",
              "kind": "summarize_items",
              "depends_on": [
                "keep-paid-large"
              ],
              "config": {
                "items_field": "orders",
                "target_field": "summary",
                "aggregations": [
                  {
                    "operation": "count",
                    "alias": "order_count"
                  },
                  {
                    "operation": "sum",
                    "field": "amount",
                    "alias": "total_amount"
                  },
                  {
                    "operation": "avg",
                    "field": "amount",
                    "alias": "average_amount"
                  },
                  {
                    "operation": "max",
                    "field": "amount",
                    "alias": "largest_amount"
                  }
                ]
              }
            },
            {
              "step_id": "report",
              "kind": "project_fields",
              "depends_on": [
                "totals",
                "tag-batch"
              ],
              "config": {
                "target_field": "report",
                "fields": [
                  "context.batch",
                  "summary.order_count",
                  "summary.total_amount"
                ]
              }
            }
          ]
        }
      },
      "status": 200,
      "volatile": [
        "/registered_at"
      ]
    },
    {
      "id": "register-pipeline-unknown-kind",
      "endpoint": "POST /api/v1/pipelines",
      "title": "A step kind the engine does not have",
      "request": {
