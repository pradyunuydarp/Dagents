    {
      "id": "register-definition",
      "endpoint": "POST /api/v1/pipeline-definitions",
      "title": "Register a pipeline that reads a registered source",
      "description": "The same handler as POST /api/v1/pipelines.",
      "request": {
        "path": "/api/v1/pipeline-definitions",
        "json": {
          "pipeline_id": "orders-profile",
          "description": "Profile a registered source, then record a classification run on it.",
          "steps": [
            {
              "step_id": "profile",
              "kind": "profile_dataset",
              "config": {
                "dataset_input": {
                  "source_id": "orders-week-41"
                },
                "scope_id": "orders-week-41",
                "feature_fields": [
                  "amount",
                  "items"
                ],
                "label_field": "returned",
                "target_field": "dataset_profile"
              }
            },
            {
              "step_id": "score",
              "kind": "run_model_job",
              "depends_on": [
                "profile"
              ],
              "config": {
                "dataset_input": {
                  "source_id": "orders-week-41"
                },
                "scope_id": "orders-week-41",
                "task_type": "classification",
                "model_family": "random_forest",
                "feature_fields": [
                  "amount",
                  "items"
                ],
                "label_field": "returned",
                "target_field": "model_run"
              }
            }
          ]
        }
      },
      "status": 200,
      "volatile": [
        "/registered_at"
      ]
    },
