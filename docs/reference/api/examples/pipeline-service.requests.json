    {
      "id": "register-cyclic-pipeline",
      "endpoint": "POST /api/v1/pipelines",
      "title": "A graph whose steps depend on each other in a cycle",
      "description": "The planner rejects the graph, and detail is its sentence. Nothing is stored.",
      "request": {
        "path": "/api/v1/pipelines",
        "json": {
          "pipeline_id": "circular-orders",
          "steps": [
            {
              "step_id": "filter",
              "kind": "filter_items",
              "depends_on": [
                "summarize"
              ]
            },
            {
              "step_id": "summarize",
              "kind": "summarize_items",
              "depends_on": [
                "filter"
              ]
            }
          ]
        }
      },
      "status": 422
