{
  "service": "model-service",
  "note": "Captured in process. MODEL_ARTIFACT_DIR points at a temporary folder, so the saved models stay out of the repository.",
  "env": {
    "MODEL_ARTIFACT_DIR": "/tmp/dagents-api-examples/artifacts"
  },
  "examples": [
    {
      "id": "health",
      "endpoint": "GET /api/v1/health",
      "title": "Check that the service answers",
      "request": {
        "path": "/api/v1/health"
      },
      "status": 200
    },
    {
      "id": "datasets",
      "endpoint": "GET /api/v1/datasets",
      "title": "List the benchmark datasets",
      "request": {
        "path": "/api/v1/datasets"
      },
      "status": 200
    },
    {
      "id": "model-families",
      "endpoint": "GET /api/v1/model-families",
      "title": "List what this deployment can run",
      "request": {
        "path": "/api/v1/model-families"
      },
      "status": 200,
      "trim": {
        "items": 10,
        "chars": 400
      }
    },
    {
      "id": "register-source",
      "endpoint": "POST /api/v1/sources",
      "title": "Register an inline source of 20 orders",
      "description": "The checks and the training examples below read these records by source_id.",
