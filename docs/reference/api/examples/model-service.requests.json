    {
      "id": "list-jobs",
      "endpoint": "GET /api/v1/model-jobs",
      "title": "List the jobs",
      "description": "The job runs while other requests are answered, so its state at this moment varies. The replay check ignores it.",
      "request": {
        "path": "/api/v1/model-jobs",
        "query": {
          "limit": 5
        }
      },
      "status": 200,
      "volatile": [
        "/jobs/*/job_id",
        "/jobs/*/status",
        "/jobs/*/submitted_at",
        "/jobs/*/started_at",
        "/jobs/*/completed_at",
        "/jobs/*/result",
        "/jobs/*/error"
      ]
    },
    {
      "id": "list-jobs-422",
      "endpoint": "GET /api/v1/model-jobs",
      "title": "A limit that is not a number",
      "request": {
        "path": "/api/v1/model-jobs",
        "query": {
          "limit": "five"
        }
      },
      "status": 422
    },
    {
      "id": "get-job",
      "endpoint": "GET /api/v1/model-jobs/{job_id}",
      "title": "Fetch the job the submit example started",
      "description": "The job_id in the path is the one the submit example returned. The job runs while other requests are answered, so its state at this moment varies, and the replay check ignores it.",
      "request": {
        "path": "/api/v1/model-jobs/{from:submit-job:/job_id}"
      },
      "status": 200,
      "volatile": [
        "/job_id",
        "/status",
        "/submitted_at",
        "/started_at",
        "/completed_at",
        "/result",
        "/error"
      ]
    },
    {
      "id": "get-missing-job",
      "endpoint": "GET /api/v1/model-jobs/{job_id}",
      "title": "Fetch a job that does not exist",
      "request": {
        "path": "/api/v1/model-jobs/model-job-0"
      },
      "status": 404
    }
  ]
