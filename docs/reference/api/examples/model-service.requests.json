    {
      "id": "register-source-422",
      "endpoint": "POST /api/v1/sources",
      "title": "A body that is not a JSON object",
      "request": {
        "path": "/api/v1/sources",
        "json": [
          "orders-week-41"
        ]
      },
      "status": 422
    },
    {
      "id": "list-sources",
      "endpoint": "GET /api/v1/sources",
      "title": "List the registered sources",
      "request": {
        "path": "/api/v1/sources"
      },
      "status": 200,
      "trim": {
        "items": 3
      }
    },
    {
      "id": "get-source",
      "endpoint": "GET /api/v1/sources/{source_id}",
      "title": "Fetch one source",
      "request": {
        "path": "/api/v1/sources/orders-week-41"
      },
      "status": 200,
      "trim": {
        "items": 3
      }
    },
    {
      "id": "get-missing-source",
      "endpoint": "GET /api/v1/sources/{source_id}",
      "title": "Fetch a source that does not exist",
      "request": {
        "path": "/api/v1/sources/no-such-source"
      },
      "status": 404
    },
    {
      "id": "validate-source",
      "endpoint": "POST /api/v1/sources/{source_id}:validate",
      "title": "Validate the inline source",
      "request": {
        "path": "/api/v1/sources/orders-week-41:validate"
      },
      "status": 200
    },
    {
      "id": "validate-missing-source",
      "endpoint": "POST /api/v1/sources/{source_id}:validate",
      "title": "Validate a source that does not exist",
      "request": {
        "path": "/api/v1/sources/no-such-source:validate"
      },
      "status": 404
    },
    {
      "id": "classification-check",
      "endpoint": "POST /api/v1/checks/classification",
      "title": "Check a random forest that flags fraud",
      "request": {
        "path": "/api/v1/checks/classification",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "feature_fields": [
            "amount",
            "items",
            "hour"
          ],
          "label_field": "is_fraud"
        }
      },
      "status": 200
    },
    {
      "id": "classification-planned-family",
      "endpoint": "POST /api/v1/checks/classification",
      "title": "A family the planner knows but this service cannot run",
      "request": {
        "path": "/api/v1/checks/classification",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "label_field": "is_fraud",
          "model_family": "xgboost"
        }
      },
      "status": 400
    },
    {
      "id": "classification-no-data",
      "endpoint": "POST /api/v1/checks/classification",
      "title": "A request with no data",
      "request": {
        "path": "/api/v1/checks/classification",
        "json": {
          "label_field": "is_fraud"
        }
      },
      "status": 422
    },
    {
      "id": "regression-check",
      "endpoint": "POST /api/v1/checks/regression",
      "title": "Check how well items and hour predict the amount",
      "description": "Metric values from a fitted model can differ in the last digits between machines, so the replay check ignores them.",
      "request": {
        "path": "/api/v1/checks/regression",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "feature_fields": [
            "items",
            "hour"
          ],
          "label_field": "amount"
        }
      },
      "status": 200,
      "volatile": [
        "/metrics/*"
      ]
    },
    {
      "id": "regression-wrong-task",
      "endpoint": "POST /api/v1/checks/regression",
      "title": "A family that serves another task",
      "request": {
        "path": "/api/v1/checks/regression",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "label_field": "amount",
          "model_family": "naive_bayes"
        }
      },
      "status": 400
    },
    {
      "id": "train",
      "endpoint": "POST /api/v1/train",
      "title": "Train an autoencoder with one candidate",
      "description": "search narrows the default 8 candidates to 1. The threshold comes from a trained network, so the replay check ignores it.",
      "request": {
        "path": "/api/v1/train",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "feature_fields": [
            "amount",
            "items",
            "hour"
          ],
          "label_field": "is_fraud",
          "artifact_name": "orders-autoencoder.pt",
          "search": {
            "values": {
              "hidden_dims": [
                [
                  16,
                  8
                ]
              ],
              "dropout": [
                0.0
              ],
              "pca_components": [
                null
              ]
            }
          }
        }
      },
      "status": 200,
      "volatile": [
        "/metrics/threshold"
      ]
    },
    {
      "id": "train-planned-family",
      "endpoint": "POST /api/v1/train",
      "title": "A family that is planned for anomaly detection",
      "request": {
        "path": "/api/v1/train",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "label_field": "is_fraud",
          "model_family": "random_forest"
        }
      },
      "status": 400
    },
    {
      "id": "train-422",
      "endpoint": "POST /api/v1/train",
      "title": "A max_rows below the minimum",
      "request": {
        "path": "/api/v1/train",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "max_rows": 50
        }
      },
      "status": 422
    },
    {
      "id": "submit-job",
      "endpoint": "POST /api/v1/model-jobs",
      "title": "Submit the same training as a background job",
      "description": "job_id and submitted_at come from the clock.",
      "request": {
        "path": "/api/v1/model-jobs",
        "json": {
          "dataset": {
            "source_id": "orders-week-41"
          },
          "feature_fields": [
            "amount",
            "items",
            "hour"
          ],
          "label_field": "is_fraud",
          "artifact_name": "orders-autoencoder-job.pt",
          "search": {
            "values": {
              "hidden_dims": [
                [
                  16,
                  8
                ]
              ],
              "dropout": [
                0.0
              ],
              "pca_components": [
                null
              ]
            }
          }
        }
      },
      "status": 202,
      "volatile": [
        "/job_id",
        "/submitted_at"
      ]
    },
