    {
      "id": "source-validate",
      "endpoint": "dagentsc dataset source validate",
      "title": "Validate a Postgres source",
      "description": "The input is docs/demo/inputs/source-postgres-valid.json.",
      "request": {
        "args": [
          "dataset",
          "source",
          "validate",
          "--input",
          "-"
        ],
        "stdin": {
          "sourceId": "orders-postgres",
          "kind": "postgres",
          "connectionRef": {
            "connectionId": "warehouse-demo"
          },
          "selection": {
            "table": "public.orders",
            "columns": [
              "order_id",
              "tenant_id",
              "event_time",
              "amount",
              "status",
              "risk_score"
            ],
            "where": "event_time >= '2026-05-01T00:00:00Z'",
            "orderBy": [
              "event_time"
            ]
          },
          "format": "rows",
          "batching": {
            "batchSize": 500,
            "maxRecords": 5000
          },
          "options": {
            "timeField": "event_time",
            "timeWindow": "1h",
            "partitionField": "tenant_id",
            "partitionCount": "8"
          }
        }
      },
      "status": 0
    },
    {
      "id": "source-validate-invalid",
      "endpoint": "dagentsc dataset source validate",
      "title": "A Postgres source with no connection, no table and a batch size of 0",
      "description": "The input is docs/demo/inputs/source-invalid.json. A source that is not valid is a normal result, so the exit code is 0.",
      "request": {
        "args": [
          "dataset",
          "source",
          "validate",
          "--input",
          "-"
        ],
        "stdin": {
          "sourceId": "broken-postgres",
          "kind": "postgres",
          "selection": {
            "columns": [
              "order_id",
              "amount"
            ]
          },
          "format": "rows",
          "batching": {
            "batchSize": 0
          }
        }
      },
      "status": 0
    },
