    {
      "id": "restrict-narrow",
      "endpoint": "dagentsc governance restrict",
      "title": "Plan a row request from a verified analyst",
      "request": {
        "args": [
          "governance",
          "restrict",
          "--input",
          "-"
        ],
        "stdin": {
          "requestId": "plan-rows-001",
          "boundary": "before_read",
          "requester": {
            "requesterId": "returns-analyst-17",
            "requesterKind": "human",
            "affiliation": "retail-hq",
            "statedPurpose": "order_returns",
            "attributes": [
              {
                "attributeId": "employee_sso",
                "weight": 1.0,
                "verified": true
              },
              {
                "attributeId": "signed_data_agreement",
                "weight": 1.0,
                "verified": true
              }
            ],
            "complianceHistory": 0.9
          },
          "classification": {
            "classificationId": "retail-orders",
            "fieldSensitivity": {
              "order_value": "high",
              "customer_age_band": "medium",
              "loyalty_member": "medium",
              "returned": "medium",
              "items": "low",
              "category": "low",
              "model_update": "high"
            },
            "defaultSensitivity": "high",
            "regulations": [
              "GDPR"
            ],
            "minimumCohort": 20
          },
          "requestedFields": [
            "order_value",
            "category",
            "customer_age_band",
            "customer_postcode"
          ],
          "granularity": "row",
          "declaredPurpose": "order_returns",
          "approvedPurposes": [
            "order_returns",
            "returns_quality_review"
          ]
        }
      },
      "status": 0,
      "trim": {
        "items": 10
      }
    },
