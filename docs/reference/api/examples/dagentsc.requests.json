{
  "service": "dagentsc",
  "note": "Each example runs the planner binary with its arguments and its JSON on standard input, from the repository root, so a path such as docs/demo/inputs/quality-rules-orders.json is read from the repository.",
  "examples": [
    {
      "id": "manifest-from-input",
      "endpoint": "dagentsc manifest compile",
      "title": "Compile a workload plan from JSON",
      "description": "The input is docs/demo/inputs/workload-plan.json.",
      "request": {
        "args": [
          "manifest",
          "compile",
          "--input",
          "-",
          "--output",
          "json"
        ],
        "stdin": {
          "planId": "demo-workload-plan",
          "namespace": "dagents-demo",
          "includeServices": true,
          "includeConfigMaps": true,
          "components": [
            {
              "name": "orders-risk-worker",
              "image": "ghcr.io/dagents/orders-risk-worker:demo",
              "kind": "Deployment",
              "replicas": 2,
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080
                }
              ],
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "demo"
                }
              ],
              "args": [
                "--pipeline=orders-risk-demo"
              ]
            }
          ]
        }
      },
      "status": 0,
      "trim": {
        "chars": 2000
      }
    },
    {
      "id": "manifest-from-flags",
      "endpoint": "dagentsc manifest compile",
      "title": "Render YAML for one Job from flags, without an input",
      "request": {
        "args": [
          "manifest",
          "compile",
          "--plan-id",
          "nightly-profile",
          "--name",
          "profile-orders",
          "--image",
          "ghcr.io/example/dagents-lma:0.1.0",
          "--kind",
          "Job"
        ]
      },
      "status": 0,
      "trim": {
        "chars": 2000
      }
    },
    {
      "id": "pipeline-from-input",
      "endpoint": "dagentsc pipeline compile",
      "title": "Order a pipeline's steps",
      "description": "The input is docs/demo/inputs/pipeline-valid.json.",
      "request": {
        "args": [
          "pipeline",
          "compile",
          "--input",
          "-",
          "--output",
          "json"
        ],
        "stdin": {
          "pipelineId": "orders-risk-demo",
          "steps": [
            {
              "stepId": "enrich",
              "kind": "enrich_context",
              "dependsOn": [],
              "config": {
                "target_field": "context",
                "values": {
                  "demo": "functional-planning"
                }
              }
            },
            {
              "stepId": "filter",
              "kind": "filter_items",
              "dependsOn": [
                "enrich"
              ],
              "config": {
                "items_field": "items",
                "conditions": [
                  {
                    "field": "risk_score",
                    "operator": "gte",
                    "value": 0.3
                  }
                ]
              }
            },
            {
              "stepId": "profile",
              "kind": "profile_dataset",
              "dependsOn": [
                "filter"
              ],
              "config": {
                "items_field": "items",
                "feature_fields": [
                  "amount_usd",
                  "risk_score"
                ]
              }
            },
            {
              "stepId": "model",
              "kind": "run_model_job",
              "dependsOn": [
                "profile"
              ],
              "config": {
                "items_field": "items",
                "model_family": "autoencoder",
                "task_type": "anomaly_detection"
              }
            }
          ]
        }
      },
      "status": 0
    },
    {
      "id": "pipeline-from-steps",
      "endpoint": "dagentsc pipeline compile",
      "title": "Order steps given as flags, as text",
      "description": "The steps are given out of order. The output lists them in the order they run, one step_id:kind per line.",
      "request": {
        "args": [
          "pipeline",
          "compile",
          "--pipeline-id",
          "orders-nightly",
          "--step",
          "report:project_fields:score",
          "--step",
          "load:profile_dataset",
          "--step",
          "score:run_model_job:load"
        ]
      },
      "status": 0
    },
    {
      "id": "pipeline-cycle",
      "endpoint": "dagentsc pipeline compile",
      "title": "A pipeline whose steps depend on each other",
      "description": "The input is docs/demo/inputs/pipeline-cyclic.json. The planner stops with an exception, which is exit code 2.",
      "request": {
        "args": [
          "pipeline",
          "compile",
          "--input",
          "-",
          "--output",
          "json"
        ],
        "stdin": {
          "pipelineId": "cyclic-demo",
          "steps": [
            {
              "stepId": "a",
              "kind": "filter_items",
              "dependsOn": [
                "b"
              ]
            },
            {
              "stepId": "b",
              "kind": "project_fields",
              "dependsOn": [
                "a"
              ]
            }
          ]
        }
      },
      "status": 2
    },
    {
      "id": "route-classification",
      "endpoint": "dagentsc model route",
      "title": "Route a classification task",
      "request": {
        "args": [
          "model",
          "route",
          "--task",
          "classification",
          "--output",
          "json"
        ]
      },
      "status": 0
    },
    {
      "id": "route-unknown-task",
      "endpoint": "dagentsc model route",
      "title": "A task the router does not know is routed as anomaly detection",
      "request": {
        "args": [
          "model",
          "route",
          "--task",
          "clustering"
        ]
      },
      "status": 0
    },
    {
      "id": "profile",
      "endpoint": "dagentsc dataset profile",
      "title": "Profile the built-in two-record dataset",
      "request": {
        "args": [
          "dataset",
          "profile",
          "--scope-id",
          "orders",
          "--output",
