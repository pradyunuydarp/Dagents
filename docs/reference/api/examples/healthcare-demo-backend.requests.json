    {
      "id": "fhir",
      "endpoint": "POST /api/v1/ingest:fhir",
      "title": "Map a FHIR-shaped encounter with two observations",
      "description": "The systolic pressure arrives in kPa and is converted to mmHg. LOINC 8462-4 (diastolic pressure) is not in the mapper's table, so it is reported in unmapped_codes.",
      "request": {
        "path": "/api/v1/ingest:fhir",
        "json": {
          "bundle": {
            "resourceType": "Bundle",
            "type": "collection",
            "entry": [
              {
                "resource": {
                  "resourceType": "Encounter",
                  "id": "enc-1",
                  "age": 77,
                  "gender": "female",
                  "consciousLevel": "alert",
                  "faceWeakness": true,
                  "armWeakness": true,
                  "legWeakness": false,
                  "speechDifficulty": true,
                  "visualFieldLoss": false,
                  "atrialFibrillation": false,
                  "onsetOnWaking": false,
                  "strokeSubtype": "PACS",
                  "minutesSinceOnset": 210
                }
              },
              {
                "resource": {
                  "resourceType": "Observation",
                  "encounter": {
                    "reference": "Encounter/enc-1"
                  },
                  "code": {
                    "coding": [
                      {
                        "system": "http://loinc.org",
                        "code": "8480-6"
                      }
                    ]
                  },
                  "valueQuantity": {
                    "value": 21.3,
                    "unit": "kPa"
                  }
                }
              },
              {
                "resource": {
                  "resourceType": "Observation",
                  "encounter": {
                    "reference": "Encounter/enc-1"
                  },
                  "code": {
                    "coding": [
                      {
                        "system": "http://loinc.org",
                        "code": "8462-4"
                      }
                    ]
                  },
                  "valueQuantity": {
                    "value": 92,
                    "unit": "mmHg"
                  }
                }
              }
            ]
          }
        }
      },
      "status": 200
    },
