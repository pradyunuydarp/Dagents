      "id": "probe",
      "endpoint": "POST /api/v1/governance:probe",
      "title": "Ask Hospital 134's Guard about a row request from a verified person",
      "request": {
        "path": "/api/v1/governance:probe",
        "json": {
          "site_id": "uk-134"
        }
      },
      "status": 200,
      "volatile": [
