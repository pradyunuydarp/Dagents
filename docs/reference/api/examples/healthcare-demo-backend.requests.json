        "/framework_calls/*/ms",
        "/rounds/*/acceptances/*/round_id",
        "/rounds/training/*/acceptances/*/round_id",
        "/rounds/*/dispatch",
        "/rounds/training/*/dispatch"
      ]
    },
    {
      "id": "pilot-bad-prefix",
      "endpoint": "POST /api/v1/pilot:run",
      "title": "A round prefix that is not ui or api",
      "request": {
        "path": "/api/v1/pilot:run",
        "json": {
          "round_prefix": "nightly"
        }
      },
      "status": 422
    },
    {
      "id": "models",
      "endpoint": "GET /api/v1/models",
      "title": "List the model versions after one pilot",
      "request": {
        "path": "/api/v1/models"
      },
      "status": 200,
      "trim": {
        "items": 3,
        "chars": 300
      },
      "volatile": [
        "/model_in_use/created_at",
        "/models/*/created_at",
        "/models/*/version",
        "/models/*/parent_version",
        "/framework_calls/*/ms"
      ]
    },
    {
      "id": "approve-unknown",
      "endpoint": "POST /api/v1/models/{version}:approve",
      "title": "Approve a version that does not exist",
      "request": {
        "path": "/api/v1/models/no-such-version:approve"
      },
      "status": 404
    },
    {
      "id": "approve-not-candidate",
      "endpoint": "POST /api/v1/models/{version}:approve",
      "title": "Approve the seed rule, which no pilot produced",
      "request": {
        "path": "/api/v1/models/stroke-outcome-rule-v1:approve"
      },
      "status": 409
    },
    {
      "id": "approve-rate-limited",
      "endpoint": "POST /api/v1/models/{version}:approve",
      "title": "A third approval within a minute",
      "description": "The capture limited approvals to 2 per minute (the default is 10), so this third request was refused.",
      "request": {
        "path": "/api/v1/models/stroke-outcome-rule-v1:approve"
      },
      "status": 429
    },
    {
      "id": "deployments",
      "endpoint": "GET /api/v1/deployments",
      "title": "Read whether this server can add a hospital, and why not",
      "request": {
        "path": "/api/v1/deployments"
      },
      "status": 200
    },
    {
      "id": "deploy-in-process",
      "endpoint": "POST /api/v1/deployments",
      "title": "Ask a server that runs the agents in process to add a hospital",
      "request": {
        "path": "/api/v1/deployments",
        "json": {
          "site_id": "pl-290"
        }
      },
      "status": 403
    },
    {
      "id": "deploy-unknown-site",
      "endpoint": "POST /api/v1/deployments",
      "title": "A hospital that cannot join",
      "request": {
        "path": "/api/v1/deployments",
        "json": {
          "site_id": "uk-134"
        }
      },
      "status": 422
    },
    {
      "id": "deploy-foreign-origin",
      "endpoint": "POST /api/v1/deployments",
      "title": "A request from a page on another host",
      "request": {
        "path": "/api/v1/deployments",
        "headers": {
          "Origin": "https://example.org"
        },
        "json": {
          "site_id": "pl-290"
        }
      },
      "status": 403
    },
    {
      "id": "status",
      "endpoint": "GET /api/v1/framework/status",
      "title": "Read where the records are stored and how the agents run",
      "request": {
        "path": "/api/v1/framework/status"
      },
      "status": 200,
      "volatile": [
        "/framework_calls/*/ms",
        "/framework_calls/*/service",
        "/framework_calls/*/site_id"
      ]
    }
  ]
}
