        "/framework_calls/*/ms"
      ]
    },
    {
      "id": "probe-small-table",
      "endpoint": "POST /api/v1/governance:probe",
      "title": "A table request about 12 patients from an unverified requester",
      "description": "A table request describes a group, so the planner checks it against the minimum cohort of 20 and denies it.",
      "request": {
        "path": "/api/v1/governance:probe",
        "json": {
          "site_id": "uk-134",
          "verified": false,
          "boundary": "before_send",
          "granularity": "table",
          "requested_fields": [
            "systolic_bp",
            "age_band"
          ],
          "cohort_size": 12
        }
      },
      "status": 200,
      "volatile": [
        "/audit_id",
        "/request_id",
        "/plan/request_id",
        "/plan/obligations/0",
        "/framework_calls/*/ms"
      ]
    },
