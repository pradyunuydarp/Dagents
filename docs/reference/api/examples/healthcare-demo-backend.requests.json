{
  "service": "healthcare-demo-backend",
  "note": "Captured in process with the planner available and no database, so each hospital's records are in memory, loaded from apps/healthcare-demo/data/ist/. The three LMAs and the GMA run inside the app and are called through httpx.ASGITransport, as on the published demo. The per-client limits and hourly caps are off, except model approvals, which are limited to 2 per minute so the last approval example shows a 429. Adding a hospital is off (HEALTHCARE_DEMO_DEPLOYER=off) and the agents run in process, so the deployment examples show the refusals; a network-mode run started with --deploy adds the hospital. The agents' tokens are new on every run and appear in no answer. The time each agent call took (framework_calls ms) changes on every run, so the replay check ignores it.",
  "env": {
    "HEALTHCARE_DEMO_DATABASE_URL": "",
    "HEALTHCARE_DEMO_AGENTS": "in-process",
    "HEALTHCARE_DEMO_RATE_LIMIT_ENTRIES": "0",
    "HEALTHCARE_DEMO_RATE_LIMIT_PROBES": "0",
    "HEALTHCARE_DEMO_RATE_LIMIT_PILOTS": "0",
    "HEALTHCARE_DEMO_RATE_LIMIT_APPROVALS": "2",
    "HEALTHCARE_DEMO_PROBES_PER_SITE_PER_HOUR": "0",
    "HEALTHCARE_DEMO_PILOTS_PER_HOUR": "0",
    "HEALTHCARE_DEMO_CORS_ORIGINS": "",
    "HEALTHCARE_DEMO_TRUST_FORWARDED_FOR": "0",
    "NO_PROXY": "127.0.0.1,localhost",
    "no_proxy": "127.0.0.1,localhost",
    "HEALTHCARE_DEMO_DEPLOYER": "off"
  },
  "examples": [
