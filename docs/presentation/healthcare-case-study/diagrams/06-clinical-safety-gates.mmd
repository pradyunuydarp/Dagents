flowchart LR
  A[Candidate patient event] --> B{Authorized data scope?}
  B -- no --> X[Stop + audit]
  B -- yes --> C{Fresh, complete, valid inputs?}
  C -- no --> X
  C -- yes --> D{Approved model and site configuration?}
  D -- no --> X
  D -- yes --> E[Generate decision-support output]
  E --> F[Show inputs, model version, uncertainty, known limitations]
  F --> G{Clinician accepts responsibility for action?}
  G -- no --> H[Defer / dismiss with reason]
  G -- yes --> I[Clinical workflow action]
  H --> J[Outcome + feedback trace]
  I --> J
  J --> K[Monitor alert burden, calibration, drift, subgroup performance]
  K --> L{Threshold breached?}
  L -- yes --> M[Pause or rollback bundle; governance review]
  L -- no --> A

  classDef gate fill:#E8E0F5,stroke:#7355A3,color:#15201B,stroke-width:2px;
  classDef stop fill:#F4D9D3,stroke:#A34A3A,color:#15201B,stroke-width:2px;
  classDef flow fill:#DDE9F2,stroke:#356A8A,color:#15201B,stroke-width:2px;
  classDef safe fill:#DCEADF,stroke:#2B6D4F,color:#15201B,stroke-width:2px;
  class B,C,D,G,L gate;
  class X,M stop;
  class A,E,F,H,I,J flow;
  class K safe;
