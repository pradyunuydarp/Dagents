# Healthcare stroke-triage demo. No secrets belong in this file.
#
# backend/app/core/config.py reads every HEALTHCARE_DEMO_* setting below, except
# the ports of the agents and the UI, which the start scripts and the compose
# file read. A variable already set in the environment wins over this file. The
# Docker image copies this file too, so a value set here also applies on a host
# unless the host sets it; settings that must differ on a host are left
# commented out.

# The service name and environment the health check reports.
HEALTHCARE_DEMO_APP_NAME=dagents-healthcare-stroke-demo
HEALTHCARE_DEMO_APP_ENV=development
# The address and port the API binds. The Docker image reads PORT when
# HEALTHCARE_DEMO_API_PORT is not exported.
HEALTHCARE_DEMO_API_HOST=0.0.0.0
HEALTHCARE_DEMO_API_PORT=8080

# Browser origins allowed to call the API, comma-separated (scheme and host, no
# path). Empty means any origin, which suits a local run.
# HEALTHCARE_DEMO_CORS_ORIGINS=

# No database by default: each hospital keeps its records in memory, loaded
# from data/ist/ist_three_hospitals.csv. Set HEALTHCARE_DEMO_DATABASE_URL in the
# environment, never in this file, to use one Postgres schema per hospital.
# HEALTHCARE_DEMO_DATABASE_URL=

# Optional: a separate login for one hospital, set in the environment. Each one
# may act only as its hospital's role. Unset, the hospital uses
# HEALTHCARE_DEMO_DATABASE_URL.
# HEALTHCARE_DEMO_SITE_UK_134_DATABASE_URL=
# HEALTHCARE_DEMO_SITE_IT_002_DATABASE_URL=
# HEALTHCARE_DEMO_SITE_CH_245_DATABASE_URL=

# Most records each hospital's data-entry form may add; then 409.
HEALTHCARE_DEMO_MAX_ENTERED_PER_SITE=300

# Sites below which secure aggregation must not reveal a contribution.
HEALTHCARE_DEMO_SECURE_THRESHOLD=3

# Requests per client per minute for each group of POST endpoints; then 429.
# 0 turns a limit off.
HEALTHCARE_DEMO_RATE_LIMIT_ENTRIES=30
HEALTHCARE_DEMO_RATE_LIMIT_PROBES=60
HEALTHCARE_DEMO_RATE_LIMIT_PILOTS=3
HEALTHCARE_DEMO_RATE_LIMIT_APPROVALS=10

# Caps for all visitors together, in any 60 minutes; then 429. Each Guard probe
# adds a record to a hospital's audit chain and each pilot adds model versions
# and audit records, all kept in the database. 0 turns a cap off.
HEALTHCARE_DEMO_PROBES_PER_SITE_PER_HOUR=600
HEALTHCARE_DEMO_PILOTS_PER_HOUR=20

# How the rate limits identify a client. Off by default, so a local run counts
# the TCP peer. Behind proxies, set TRUST_FORWARDED_FOR=true and FORWARDED_FOR_HOPS
# to the number of proxies that append to X-Forwarded-For; the client is the
# entry that many places from the right. When RENDER is set the defaults are
# true and 3, so these stay commented out here.
# HEALTHCARE_DEMO_TRUST_FORWARDED_FOR=false
# HEALTHCARE_DEMO_FORWARDED_FOR_HOPS=1

# Largest request body, in bytes; then 413.
HEALTHCARE_DEMO_MAX_BODY_BYTES=65536

# Seconds to wait for an agent's health check in /api/v1/framework/status.
HEALTHCARE_DEMO_REQUEST_TIMEOUT_SECONDS=2.0

# Where the OCaml planner lives. Containers put dagentsc on PATH; a local run
# points this at the dune build output.
# DAGENTSC_BIN=/path/to/Dagents/bindings/ocaml/_build/default/bin/dagentsc.exe

# The UI's port: the dev server's in scripts/run_frontend_demo.sh, and the host
# port of the UI in docker-compose.yml.
HEALTHCARE_DEMO_UI_PORT=5174

# --- The Dagents agents -----------------------------------------------------
#
# The demo runs on one Dagents LMA (local monitoring agent) per hospital and
# one GMA (global monitoring agent) for the study, and calls them only through
# their HTTP APIs.
#
# in-process: the API builds the four agents in its own process and calls their
# routes without a socket, with tokens it makes when it first builds them. The
# published demo runs this way.
# network: the agents run as their own processes and the API calls them over
# HTTP. It needs HEALTHCARE_DEMO_DATABASE_URL, because separate processes cannot
# share an in-memory store. scripts/run_local_demo.sh --agents network and
# docker-compose.yml start this layout.
HEALTHCARE_DEMO_AGENTS=in-process

# Network mode: the port of the GMA and of each hospital's LMA. The start
# scripts and the compose file read them; the API reads the addresses below.
HEALTHCARE_DEMO_GMA_PORT=8081
HEALTHCARE_DEMO_LMA_UK_134_PORT=8082
HEALTHCARE_DEMO_LMA_IT_002_PORT=8083
HEALTHCARE_DEMO_LMA_CH_245_PORT=8084

# Network mode: the GMA's address and its admin token, and each hospital's LMA
# address and that LMA's site token. scripts/run_local_demo.sh sets them with
# new tokens for each run; docker-compose.yml makes its tokens once per volume.
# Set tokens in the environment, never in this file.
# HEALTHCARE_DEMO_GMA_URL=
# HEALTHCARE_DEMO_GMA_TOKEN=
# HEALTHCARE_DEMO_LMA_UK_134_URL=
# HEALTHCARE_DEMO_LMA_UK_134_TOKEN=
# HEALTHCARE_DEMO_LMA_IT_002_URL=
# HEALTHCARE_DEMO_LMA_IT_002_TOKEN=
# HEALTHCARE_DEMO_LMA_CH_245_URL=
# HEALTHCARE_DEMO_LMA_CH_245_TOKEN=

# Most public requests the API works on at once. A request waits up to
# HEALTHCARE_DEMO_IN_FLIGHT_WAIT_SECONDS for a slot, then gets 503. The health
# routes are never held back.
HEALTHCARE_DEMO_MAX_IN_FLIGHT=12
HEALTHCARE_DEMO_IN_FLIGHT_WAIT_SECONDS=20

# In process: how many agent handlers may run at once, across the three LMAs
# and the GMA. The API refuses to start with fewer than
# 4 x HEALTHCARE_DEMO_MAX_IN_FLIGHT + 8.
HEALTHCARE_DEMO_AGENT_THREAD_TOKENS=64

# How many hospitals the GMA sends a round's jobs to at once, from 1 to 64. In
# network mode the start scripts and the compose file pass it to the GMA.
HEALTHCARE_DEMO_DISPATCH_CONCURRENCY=3

# --- Adding a hospital while the demo runs -----------------------------------
#
# A network-mode run on your own machine, started with --deploy
# (scripts/run_local_demo.sh --agents network --deploy, or
# docker-compose.deploy.yml), can add Hospital 290 while the demo runs. The
# app asks core-service for the new LMA's Compose file and starts that one
# service. It starts a process or a container, so it is off unless a run turns
# it on: the start scripts set it to process only with --deploy, and to off
# otherwise. The API refuses to start with it on when RENDER is set or the
# agents run in process.
# off, process (a local process) or compose (a container).
HEALTHCARE_DEMO_DEPLOYER=off

# The ports of the joining hospital's LMA and of core-service. The start
# scripts and docker-compose.deploy.yml read them; the app reads the addresses
# below.
HEALTHCARE_DEMO_LMA_PL_290_PORT=8085
HEALTHCARE_DEMO_CORE_SERVICE_PORT=8040

# Set by a run with --deploy: core-service's address, the joining hospital's
# LMA address and the app's site token for it. Set the token in the
# environment, never in this file.
# HEALTHCARE_DEMO_CORE_SERVICE_URL=
# HEALTHCARE_DEMO_LMA_PL_290_URL=
# HEALTHCARE_DEMO_LMA_PL_290_TOKEN=

# Seconds to wait for the new LMA to answer its health check.
HEALTHCARE_DEMO_DEPLOY_TIMEOUT_SECONDS=90

# Where the deployer writes its logs and pid files (process) or the rendered
# files (compose). Empty means a new temporary folder. The new LMA's env file,
# lma-pl-290.env, with its tokens and its database address, is in
# HEALTHCARE_DEMO_DEPLOY_ENV_DIR, or else in the deploy folder; it must be
# readable by its owner only.
# HEALTHCARE_DEMO_DEPLOY_DIR=
# HEALTHCARE_DEMO_DEPLOY_ENV_DIR=

# Compose mode: the image the new LMA runs, and the running demo's network.
HEALTHCARE_DEMO_DEPLOY_IMAGE=dagents/healthcare-demo-backend:local
HEALTHCARE_DEMO_DEPLOY_NETWORK=healthcare-demo_default
