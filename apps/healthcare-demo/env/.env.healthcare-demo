# Healthcare stroke-triage demo. No secrets belong in this file.
#
# backend/app/core/config.py reads every setting below. A variable already set
# in the environment wins over this file. The Docker image copies this file
# too, so a value set here also applies on a host unless the host sets it;
# settings that must differ on a host are left commented out.

# The service name and environment the health check reports.
HEALTHCARE_DEMO_APP_NAME=dagents-healthcare-stroke-demo
HEALTHCARE_DEMO_APP_ENV=development
# The address and port the API binds. The Docker image reads PORT when
# HEALTHCARE_DEMO_API_PORT is not exported.
HEALTHCARE_DEMO_API_HOST=0.0.0.0
HEALTHCARE_DEMO_API_PORT=8080

# Browser origins allowed to call the API, comma-separated (scheme and host, no
# path). Empty means any origin, which suits a local run.
# HEALTHCARE_DEMO_CORS_ORIGINS=

# No database by default: each hospital keeps its records in memory, loaded
# from data/ist/ist_three_hospitals.csv. Set HEALTHCARE_DEMO_DATABASE_URL in the
# environment, never in this file, to use one Postgres schema per hospital.
# HEALTHCARE_DEMO_DATABASE_URL=

# Optional: a separate login for one hospital, set in the environment. Each one
# may act only as its hospital's role. Unset, the hospital uses
# HEALTHCARE_DEMO_DATABASE_URL.
# HEALTHCARE_DEMO_SITE_UK_134_DATABASE_URL=
# HEALTHCARE_DEMO_SITE_IT_002_DATABASE_URL=
# HEALTHCARE_DEMO_SITE_CH_245_DATABASE_URL=

# Most records each hospital's data-entry form may add; then 409.
HEALTHCARE_DEMO_MAX_ENTERED_PER_SITE=300

# Sites below which secure aggregation must not reveal a contribution.
HEALTHCARE_DEMO_SECURE_THRESHOLD=3

# Requests per client per minute for each group of POST endpoints; then 429.
# 0 turns a limit off.
HEALTHCARE_DEMO_RATE_LIMIT_ENTRIES=30
HEALTHCARE_DEMO_RATE_LIMIT_PROBES=60
HEALTHCARE_DEMO_RATE_LIMIT_PILOTS=3
HEALTHCARE_DEMO_RATE_LIMIT_APPROVALS=10

# Caps for all visitors together, in any 60 minutes; then 429. Each Guard probe
# adds a record to a hospital's audit chain and each pilot adds model versions
# and audit records, all kept in the database. 0 turns a cap off.
HEALTHCARE_DEMO_PROBES_PER_SITE_PER_HOUR=600
HEALTHCARE_DEMO_PILOTS_PER_HOUR=20

# How the rate limits identify a client. Off by default, so a local run counts
# the TCP peer. Behind proxies, set TRUST_FORWARDED_FOR=true and FORWARDED_FOR_HOPS
# to the number of proxies that append to X-Forwarded-For; the client is the
# entry that many places from the right. When RENDER is set the defaults are
# true and 3, so these stay commented out here.
# HEALTHCARE_DEMO_TRUST_FORWARDED_FOR=false
# HEALTHCARE_DEMO_FORWARDED_FOR_HOPS=1

# Largest request body, in bytes; then 413.
HEALTHCARE_DEMO_MAX_BODY_BYTES=65536

# Seconds to wait for a framework service's health check.
HEALTHCARE_DEMO_REQUEST_TIMEOUT_SECONDS=2.0
# Register the app's Dagents extension (its feature contract, classification
# and condition pack) on startup.
HEALTHCARE_DEMO_REGISTER_EXTENSION=true

# Where the OCaml planner lives. Containers put dagentsc on PATH; a local run
# points this at the dune build output.
# DAGENTSC_BIN=/path/to/Dagents/bindings/ocaml/_build/default/bin/dagentsc.exe

# Framework services, when they are running. The in-process pilot needs none of
# these; only /api/v1/framework/status checks whether they answer.
CORE_SERVICE_PUBLIC_URL=http://127.0.0.1:8040
PIPELINE_SERVICE_PUBLIC_URL=http://127.0.0.1:8030
MODEL_SERVICE_PUBLIC_URL=http://127.0.0.1:8000
LMA_PUBLIC_URL=http://127.0.0.1:8010
GMA_PUBLIC_URL=http://127.0.0.1:8020
