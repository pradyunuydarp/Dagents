# Healthcare demo — encounter store and API configuration.
#
# THIS FILE IS AN EXAMPLE. Copy it, fill it in, and keep the copy out of git.
# `.gitignore` already ignores `.env` and `**/.env`, so name your copy `.env`
# and it will stay untracked. Never put a real value in this file.
#
# Where each value actually belongs in a deployment:
#
#   HEALTHCARE_DEMO_DATABASE_URL   GitHub Actions secret SUPABASE_DB_URL for the
#                                  migrate/seed workflow, and a Render
#                                  environment variable for the running API.
#   HEALTHCARE_DEMO_CORS_ORIGINS   Render environment variable.
#   HEALTHCARE_API_BASE            GitHub Actions *variable* (not a secret — it
#                                  ships in the browser bundle either way).
#
# The Supabase *publishable* key is deliberately absent. The browser never talks
# to Supabase: the API does, with credentials that bypass RLS, and the Ethical
# Guard decides what leaves. Putting a Supabase key in the frontend would route
# patient-level rows past the Guard.

# Supabase pooled connection string (Project settings → Database → Connection
# string → URI). Use the pooler host on a free instance: a container that
# restarts often exhausts direct connections.
HEALTHCARE_DEMO_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Browser origins allowed to call the API. Empty means any origin, which suits a
# local run; a deployment should name the frontend it serves.
HEALTHCARE_DEMO_CORS_ORIGINS=https://pradyunuydarp.github.io

# Encounters per simulated hospital.
HEALTHCARE_DEMO_COHORT_SIZE=400
