# Healthcare demo: settings for the hospital stores in Postgres and the API.
#
# THIS FILE IS AN EXAMPLE. Copy it, fill it in, and keep the copy out of git.
# Git ignores a copy named `.env`, `.env.local` or `env/.env.healthcare-supabase`
# (this file without `.example`), both in this repository and in the app's own
# repository after scripts/extract_repo.sh. Never put a real value in this file.
#
# Where each value belongs in a deployment:
#
#   HEALTHCARE_DEMO_DATABASE_URL   GitHub Actions secret SUPABASE_DB_URL for the
#                                  migrate/seed workflow, and a Render
#                                  environment variable for the running API.
#   HEALTHCARE_DEMO_CORS_ORIGINS   Render environment variable.
#   HEALTHCARE_API_BASE            GitHub Actions *variable* (not a secret — it
#                                  ships in the browser bundle either way).
#
# The Supabase *publishable* key is not used. The browser never talks to
# Supabase: the API does, and each store operation acts as one hospital's role
# or as the coordinator's role. The Ethical Guard decides what leaves a
# hospital. A Supabase key in the frontend would send patient-level rows past
# the Guard.

# Supabase connection string (Project settings → Database → Connection string
# → URI), on the pooler host: the direct host has an IPv6 address only. Port
# 6543 (transaction mode) and 5432 (session mode) both work, because every store
# operation is one transaction that switches role with SET LOCAL and prepared
# statements are off. See docs/deployment.md.
HEALTHCARE_DEMO_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Browser origins allowed to call the API. Empty means any origin, which suits a
# local run; a deployment should name the frontend it serves.
HEALTHCARE_DEMO_CORS_ORIGINS=https://pradyunuydarp.github.io

# Optional: a separate login per hospital. Each one may act only as its
# hospital's role. Without them every hospital uses HEALTHCARE_DEMO_DATABASE_URL.
# HEALTHCARE_DEMO_SITE_UK_134_DATABASE_URL=postgresql://<uk-134 login>:<password>@<host>:6543/postgres
# HEALTHCARE_DEMO_SITE_IT_002_DATABASE_URL=postgresql://<it-002 login>:<password>@<host>:6543/postgres
# HEALTHCARE_DEMO_SITE_CH_245_DATABASE_URL=postgresql://<ch-245 login>:<password>@<host>:6543/postgres

# Most records each hospital's data-entry form may add.
HEALTHCARE_DEMO_MAX_ENTERED_PER_SITE=300

# Requests per client per minute for each group of POST endpoints; 0 turns a
# limit off.
HEALTHCARE_DEMO_RATE_LIMIT_ENTRIES=30
HEALTHCARE_DEMO_RATE_LIMIT_PROBES=60
HEALTHCARE_DEMO_RATE_LIMIT_PILOTS=3
HEALTHCARE_DEMO_RATE_LIMIT_APPROVALS=10

# Guard probes per hospital and pilots in any 60 minutes, for all visitors
# together; 0 turns a cap off.
HEALTHCARE_DEMO_PROBES_PER_SITE_PER_HOUR=600
HEALTHCARE_DEMO_PILOTS_PER_HOUR=20

# Behind proxies, read each visitor's address from X-Forwarded-For: the entry
# FORWARDED_FOR_HOPS places from the right. Render's edge appends three entries.
# Check the value with /api/v1/framework/status (docs/deployment.md).
HEALTHCARE_DEMO_TRUST_FORWARDED_FOR=true
HEALTHCARE_DEMO_FORWARDED_FOR_HOPS=3

# Largest request body, in bytes.
HEALTHCARE_DEMO_MAX_BODY_BYTES=65536
