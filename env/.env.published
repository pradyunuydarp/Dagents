# Where the deployed parts of this project live.
#
# This file is committed on purpose. These are public addresses, not
# credentials. Nothing secret belongs here: the database URL and the deploy
# hooks are kept in Actions secrets and in Render's own environment.
#
# There is one place to change when something moves. The Pages workflow reads
# the API address from here. A repository variable of the same name overrides
# it without a commit, for example to point a branch at a staging API.
#
# Naming follows `env/.env.shared`: `*_PUBLIC_URL` is an address a browser can
# reach, and `*_INTERNAL_URL` is one on a compose network.

# The healthcare demo's API, deployed from apps/healthcare-demo/render.yaml.
# The published frontend calls it instead of replaying its recording. Override
# it with the `HEALTHCARE_API_BASE` repository variable.
#
# This is the only file in the repository that holds this address. The docs
# call an API run locally, and the page never shows the address.
# `tests/test_publishing_guards.py` fails if the API's host appears in any
# tracked file outside env/ and .github/.
HEALTHCARE_DEMO_PUBLIC_API_URL=https://dagents-healthcare-api.onrender.com

# --- the published pages -------------------------------------------------
#
# The Pages workflow takes each build's base path from `configure-pages`, and
# it reads these addresses for the link previews. Each build writes its address
# into the page's og:url and og:image tags, because crawlers ignore a relative
# address, and each preview image prints its address. A site that moves should
# fail a test instead of leaving a dead link or a broken preview:
# `tests/test_publishing_guards.py` checks that the root README links each one,
# and `tests/test_social_previews.py` that each preview image shows the address
# written here. After changing one, run `node scripts/render_social_cards.mjs`.
DAGENTS_PUBLIC_SITE_URL=https://pradyunuydarp.github.io/Dagents/
HEALTHCARE_DEMO_PUBLIC_SITE_URL=https://pradyunuydarp.github.io/Dagents/healthcare-demo/
NL2SQL_DEMO_PUBLIC_SITE_URL=https://pradyunuydarp.github.io/Dagents/nl2sql-demo/
