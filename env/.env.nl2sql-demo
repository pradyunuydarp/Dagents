NL2SQL_APP_NAME=dagents-nl2sql-demo
NL2SQL_APP_ENV=development
NL2SQL_API_HOST=0.0.0.0
NL2SQL_API_PORT=8070
NL2SQL_MODELS_DIR=models
NL2SQL_MODEL_CACHE_DIR=/tmp/dagents-nl2sql-models
NL2SQL_DEFAULT_MODEL_ID=codet5p_spider_model
NL2SQL_ALLOW_FALLBACK=true
NL2SQL_EAGER_LOAD_MODEL=false
NL2SQL_REQUEST_TIMEOUT_SECONDS=2.0
