GMA_APP_NAME=dagents-gma
GMA_APP_ENV=development
GMA_API_PORT=8020
GMA_LOG_LEVEL=info
# Federated rounds reach each site's LMA over HTTP when this lists the sites,
# as site_id=url entries separated by commas. Unset: rounds run in this process
# with no site attached, and sites send their own results.
# GMA_FEDERATION_SITES=site-a=http://lma-site-a:8010,site-b=http://lma-site-b:8010
# Seconds to wait for each call to a site. Default 120.
# GMA_FEDERATION_TIMEOUT_SECONDS=120
