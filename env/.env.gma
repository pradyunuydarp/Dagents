GMA_APP_NAME=dagents-gma
GMA_APP_ENV=development
GMA_API_PORT=8020
GMA_LOG_LEVEL=info
# Sites that may join while the GMA runs: SITE=URL,... The GMA accepts only the
# address listed for each one, sent to PUT /api/v1/federation/sites/{site_id}/address.
# Needs GMA_ENGINE=http. A site may not also be in GMA_SITE_ENDPOINTS. Empty: no
# site may join at run time.
GMA_JOINABLE_SITE_ENDPOINTS=
